---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdjustableGrid from '../components/AdjustableGrid.astro';

const information = await getEntry('sitio', 'informacion');

if (!information) {
  throw new Error('No se encontro src/content/sitio/informacion.md');
}
---

<BaseLayout title="Información" showHeader={false} showFooter={false} bodyClass="grid-prototype-page">
  <AdjustableGrid view="information" information={information.data} />
</BaseLayout>
