---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdjustableGrid from '../../components/AdjustableGrid.astro';
import { getProjectMedia } from '../../lib/projectMedia';

const proyectos = (await getCollection('proyectos'))
  .filter((project) => project.data.visible)
  .sort((a, b) => a.data.order - b.data.order);

const projectCards = proyectos
  .map((project) => {
    const media = getProjectMedia(project.data.slug, project.data.cover);
    return media.cover
      ? {
          title: project.data.title,
          slug: project.data.slug,
          year: project.data.year,
          category: project.data.category,
          cover: media.cover,
        }
      : null;
  })
  .filter((project) => project !== null);
---

<BaseLayout title="Trabajos" showHeader={false} showFooter={false} bodyClass="grid-prototype-page">
  <AdjustableGrid
    view="work"
    projects={projectCards}
  />
</BaseLayout>
