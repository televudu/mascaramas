---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCatalog from '../../components/WorkCatalog.astro';
import { getCatalogData } from '../../lib/catalog';

export async function getStaticPaths() {
  const { projects } = await getCatalogData();
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const { projects, information } = await getCatalogData();
const { slug } = Astro.params;
const project = projects.find((entry) => entry.slug === slug);
---

<BaseLayout title={project?.title ?? 'Trabajo'} bodyClass="catalog-page">
  <WorkCatalog projects={projects} information={information} initialProjectSlug={slug} />
</BaseLayout>
