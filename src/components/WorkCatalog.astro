---
import { withBase } from '../lib/paths';

interface Props {
  projects: Array<{
    title: string;
    slug: string;
    year: number;
    category: string;
    images: string[];
    sequence?: {
      frames: string[];
      fps: number;
      duration: number;
    };
    videos: string[];
    videoAspect: '16:9' | '4:3' | '1:1' | '9:16';
    synopsisHtml: string;
  }>;
  information: {
    description: string;
    email: string;
    youtube: string;
    instagram: string;
  };
  initialView?: 'project' | 'information';
  initialProjectSlug?: string;
}

const getVideoEmbedUrl = (url: string) => {
  try {
    const parsed = new URL(url);
    if (parsed.hostname.includes('youtube.com')) {
      const id = parsed.searchParams.get('v');
      return id ? `https://www.youtube-nocookie.com/embed/${id}?cc_load_policy=0` : undefined;
    }
    if (parsed.hostname === 'youtu.be') {
      const id = parsed.pathname.replace(/^\//, '');
      return id ? `https://www.youtube-nocookie.com/embed/${id}?cc_load_policy=0` : undefined;
    }
    if (parsed.hostname.includes('vimeo.com')) {
      const id = parsed.pathname.split('/').filter(Boolean).at(-1);
      return id && /^\d+$/.test(id) ? `https://player.vimeo.com/video/${id}` : undefined;
    }
  } catch {
    return undefined;
  }

  return undefined;
};

const videoAspects = {
  '16:9': '16 / 9',
  '4:3': '4 / 3',
  '1:1': '1 / 1',
  '9:16': '9 / 16',
};

const { projects, information, initialView = 'project', initialProjectSlug } = Astro.props;
const catalogProjects = projects.map((project) => ({
  ...project,
  embeds: project.videos.map(getVideoEmbedUrl).filter((url): url is string => Boolean(url)),
}));
const initialProjectIndex = Math.max(
  0,
  initialProjectSlug ? catalogProjects.findIndex((project) => project.slug === initialProjectSlug) : 0,
);
const rowCount = Math.max(4, catalogProjects.length);
const rows = Array.from({ length: rowCount }, (_, index) => catalogProjects[index]);
---

<div
  class="work-catalog"
  data-work-catalog
  data-initial-view={initialView}
  data-initial-project-index={initialProjectIndex}
>
  <header class="work-catalog__header">
    <a class="work-catalog__logo" href={withBase()} aria-label="Mascaramas, inicio">
      <img src={withBase('imagenes/logos/logo-horizontal.svg')} alt="" aria-hidden="true" />
    </a>
    <button
      class="work-catalog__information"
      type="button"
      data-catalog-information-button
      aria-pressed={initialView === 'information' ? 'true' : 'false'}
    >
      información
    </button>
  </header>

  <div class="work-catalog__body" data-work-catalog-body>
    <div class="work-catalog__list" data-work-catalog-list>
      {rows.map((project, index) => (
        <div class="work-catalog__row">
          {project ? (
            <button
              class="work-catalog__project"
              type="button"
              data-catalog-project
              data-project-index={index}
              aria-pressed={initialView === 'project' && index === initialProjectIndex ? 'true' : 'false'}
              aria-label={`Mostrar ${project.title}, ${project.year}`}
            >
              <span class="work-catalog__year">{project.year}</span>
              <span class="work-catalog__category">{project.category}</span>
              <span class="work-catalog__title">{project.title}</span>
            </button>
          ) : null}
        </div>
      ))}
    </div>

    <div class="work-catalog__details" data-catalog-details aria-live="polite">
      {catalogProjects.map((project, projectIndex) => (
        <section
          class="work-catalog__detail"
          data-catalog-detail
          data-project-index={projectIndex}
          hidden={initialView !== 'project' || projectIndex !== initialProjectIndex}
        >
          {project.sequence ? (
            <canvas
              class="work-catalog__sequence"
              data-catalog-sequence
              data-project-index={projectIndex}
              data-sequence-frames={JSON.stringify(project.sequence.frames.map(withBase))}
              data-sequence-fps={project.sequence.fps}
              data-sequence-duration={project.sequence.duration}
              aria-hidden="true"
            ></canvas>
          ) : null}
          {project.embeds.map((embed, videoIndex) => (
              <div
                class:list={[
                  'work-catalog__media',
                  videoIndex === project.embeds.length - 1 && 'work-catalog__media--before-synopsis',
                ]}
              >
                <div
                  class="work-catalog__video-frame"
                  style={`--catalog-video-aspect: ${videoAspects[project.videoAspect]};`}
                >
                  <iframe
                    src={embed}
                    title={`${project.title}, video ${videoIndex + 1}`}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
              </div>
            ))}
          <div class="work-catalog__synopsis" set:html={project.synopsisHtml}></div>
          {project.images.map((image) => (
            <div class="work-catalog__media">
              <img src={withBase(image)} alt="" aria-hidden="true" loading="lazy" />
            </div>
          ))}
        </section>
      ))}
      <section class="work-catalog__information-detail" data-catalog-information-detail hidden={initialView !== 'information'}>
        <p>{information.description}</p>
        <a href={`mailto:${information.email}`}>{information.email}</a>
        <a href={information.youtube} target="_blank" rel="noreferrer">youtube</a>
        <a href={information.instagram} target="_blank" rel="noreferrer">instagram</a>
      </section>
    </div>

    <div
      class="work-catalog__divider"
      data-catalog-divider
      data-index="0"
      role="separator"
      aria-label="Ajustar columnas de año y categoría"
      aria-orientation="vertical"
      tabindex="0"
    ></div>
    <div
      class="work-catalog__divider"
      data-catalog-divider
      data-index="1"
      role="separator"
      aria-label="Ajustar columnas de categoría y título"
      aria-orientation="vertical"
      tabindex="0"
    ></div>
    <div
      class="work-catalog__divider"
      data-catalog-divider
      data-index="2"
      role="separator"
      aria-label="Ajustar tabla y contenido"
      aria-orientation="vertical"
      tabindex="0"
    ></div>
  </div>
</div>

<script>
  const catalog = document.querySelector<HTMLElement>('[data-work-catalog]');

  if (catalog) {
    const body = catalog.querySelector<HTMLElement>('[data-work-catalog-body]');
    const list = catalog.querySelector<HTMLElement>('[data-work-catalog-list]');
    const details = catalog.querySelector<HTMLElement>('[data-catalog-details]');
    const informationButton = catalog.querySelector<HTMLButtonElement>('[data-catalog-information-button]');
    const informationDetail = catalog.querySelector<HTMLElement>('[data-catalog-information-detail]');
    const dividers = Array.from(catalog.querySelectorAll<HTMLElement>('[data-catalog-divider]'));
    const projectButtons = Array.from(catalog.querySelectorAll<HTMLButtonElement>('[data-catalog-project]'));
    const projectDetails = Array.from(catalog.querySelectorAll<HTMLElement>('[data-catalog-detail]'));
    const synopsisLinks = Array.from(catalog.querySelectorAll<HTMLAnchorElement>('.work-catalog__synopsis a'));
    const sequenceCanvases = Array.from(catalog.querySelectorAll<HTMLCanvasElement>('[data-catalog-sequence]'));
    const DEFAULT_FRACTIONS = [0.115, 0.11, 0.163, 0.612];
    const MIN_COLUMN = 20;
    let fractions = [...DEFAULT_FRACTIONS];
    let sizes: number[] = [];
    let resizeFrame = 0;

    const sizesFromFractions = (total: number) => {
      const nextSizes = new Array(fractions.length).fill(0);
      const remaining = new Set(fractions.map((_, index) => index));
      let remainingTotal = total;
      let remainingWeight = fractions.reduce((sum, value) => sum + value, 0);
      let changed = true;

      while (changed && remaining.size > 0) {
        changed = false;
        for (const index of [...remaining]) {
          const proposed = (fractions[index] / remainingWeight) * remainingTotal;
          if (proposed < MIN_COLUMN) {
            nextSizes[index] = MIN_COLUMN;
            remaining.delete(index);
            remainingTotal -= MIN_COLUMN;
            remainingWeight -= fractions[index];
            changed = true;
          }
        }
      }

      for (const index of remaining) {
        nextSizes[index] = (fractions[index] / remainingWeight) * remainingTotal;
      }

      return nextSizes;
    };

    const updateFractions = () => {
      const total = sizes.reduce((sum, value) => sum + value, 0);
      fractions = sizes.map((value) => value / total);
    };

    const render = () => {
      if (!body || !list) return;
      const yearWidth = Math.round(sizes[0]);
      const categoryWidth = Math.round(sizes[1]);
      const categoryEdge = Math.round(sizes[0] + sizes[1]);
      const tableWidth = Math.round(sizes[0] + sizes[1] + sizes[2]);
      list.style.width = `${tableWidth}px`;
      list.style.setProperty('--catalog-year-width', `${yearWidth}px`);
      list.style.setProperty('--catalog-category-width', `${categoryWidth}px`);
      catalog.style.setProperty('--catalog-table-width', `${tableWidth}px`);
      dividers[0].style.left = `${yearWidth}px`;
      dividers[1].style.left = `${categoryEdge}px`;
      dividers[2].style.left = `${tableWidth}px`;
    };

    const fitToViewport = () => {
      sizes = sizesFromFractions(Math.max(window.innerWidth, MIN_COLUMN * fractions.length));
      render();
    };

    const resizePair = (index: number, delta: number) => {
      const constrainedDelta = Math.max(MIN_COLUMN - sizes[index], Math.min(delta, sizes[index + 1] - MIN_COLUMN));
      sizes[index] += constrainedDelta;
      sizes[index + 1] -= constrainedDelta;
      updateFractions();
      render();
    };

    dividers.forEach((divider) => {
      const index = Number(divider.dataset.index);

      divider.addEventListener('pointerdown', (event) => {
        event.preventDefault();
        divider.setPointerCapture(event.pointerId);
        document.body.classList.add('is-resizing-catalog');
        const start = event.clientX;
        const initialFirst = sizes[index];
        const initialSecond = sizes[index + 1];

        const move = (moveEvent: PointerEvent) => {
          const delta = moveEvent.clientX - start;
          const constrainedDelta = Math.max(MIN_COLUMN - initialFirst, Math.min(delta, initialSecond - MIN_COLUMN));
          sizes[index] = initialFirst + constrainedDelta;
          sizes[index + 1] = initialSecond - constrainedDelta;
          updateFractions();
          render();
        };

        const finish = () => {
          divider.removeEventListener('pointermove', move);
          divider.removeEventListener('pointerup', finish);
          divider.removeEventListener('pointercancel', finish);
          document.body.classList.remove('is-resizing-catalog');
        };

        divider.addEventListener('pointermove', move);
        divider.addEventListener('pointerup', finish);
        divider.addEventListener('pointercancel', finish);
      });

      divider.addEventListener('keydown', (event) => {
        const step = event.shiftKey ? 1 : 10;
        const delta = event.key === 'ArrowLeft' ? -step : event.key === 'ArrowRight' ? step : 0;
        if (delta !== 0) {
          event.preventDefault();
          resizePair(index, delta);
        }
      });

      divider.addEventListener('dblclick', () => {
        fractions = [...DEFAULT_FRACTIONS];
        fitToViewport();
      });
    });

    const sequenceControllers = sequenceCanvases.map((canvas) => {
      const context = canvas.getContext('2d');
      const frameUrls = JSON.parse(canvas.dataset.sequenceFrames ?? '[]') as string[];
      const fps = Number(canvas.dataset.sequenceFps) || 12;
      const duration = (Number(canvas.dataset.sequenceDuration) || 4) * 1000;
      const images = frameUrls.map((src) => {
        const image = new Image();
        image.src = src;
        return image;
      });
      const loaded = Promise.all(images.map((image) => (
        image.complete
          ? Promise.resolve()
          : new Promise<void>((resolve) => {
              image.addEventListener('load', () => resolve(), { once: true });
              image.addEventListener('error', () => resolve(), { once: true });
            })
      )));
      let animationFrame = 0;
      let run = 0;

      const clear = () => {
        if (context) context.clearRect(0, 0, canvas.width, canvas.height);
      };

      const stop = () => {
        run += 1;
        cancelAnimationFrame(animationFrame);
        clear();
      };

      const start = async () => {
        stop();
        const currentRun = run;
        await loaded;
        if (currentRun !== run || !context || images.length === 0) return;

        const startTime = performance.now();
        const draw = (time: number) => {
          if (currentRun !== run) return;
          const bounds = canvas.getBoundingClientRect();
          const scale = Math.min(window.devicePixelRatio || 1, 2);
          const width = Math.max(1, Math.round(bounds.width * scale));
          const height = Math.max(1, Math.round(bounds.height * scale));
          if (canvas.width !== width || canvas.height !== height) {
            canvas.width = width;
            canvas.height = height;
          }

          const elapsed = time - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const frame = images[Math.floor(elapsed / (1000 / fps)) % images.length];
          context.clearRect(0, 0, width, height);

          if (frame.naturalWidth > 0) {
            const frameAspect = frame.naturalWidth / frame.naturalHeight;
            const drawHeight = Math.min(height * 0.72, width * 0.55 / frameAspect);
            const drawWidth = drawHeight * frameAspect;
            const x = width + drawWidth * 0.08 - progress * (width + drawWidth * 1.16);
            const y = (height - drawHeight) / 2;
            context.drawImage(frame, x, y, drawWidth, drawHeight);
          }

          if (progress < 1) {
            animationFrame = requestAnimationFrame(draw);
          } else {
            clear();
          }
        };

        animationFrame = requestAnimationFrame(draw);
      };

      return { projectIndex: Number(canvas.dataset.projectIndex), start, stop };
    });

    const playSequence = (index?: number) => {
      sequenceControllers.forEach((controller) => {
        if (controller.projectIndex === index) controller.start();
        else controller.stop();
      });
    };

    const selectProject = (index: number) => {
      projectButtons.forEach((button) => button.setAttribute('aria-pressed', `${Number(button.dataset.projectIndex) === index}`));
      informationButton?.setAttribute('aria-pressed', 'false');
      if (informationDetail) informationDetail.hidden = true;
      projectDetails.forEach((detail) => {
        detail.hidden = Number(detail.dataset.projectIndex) !== index;
      });
      if (details) details.scrollTop = 0;
      playSequence(index);
    };

    synopsisLinks.forEach((link) => {
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
    });

    projectButtons.forEach((button) => {
      button.addEventListener('click', () => selectProject(Number(button.dataset.projectIndex)));
    });

    informationButton?.addEventListener('click', () => {
      projectButtons.forEach((button) => button.setAttribute('aria-pressed', 'false'));
      projectDetails.forEach((detail) => {
        detail.hidden = true;
      });
      informationButton.setAttribute('aria-pressed', 'true');
      if (informationDetail) informationDetail.hidden = false;
      if (details) details.scrollTop = 0;
      playSequence();
    });

    fitToViewport();
    if (catalog.dataset.initialView === 'project') {
      playSequence(Number(catalog.dataset.initialProjectIndex));
    }
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(fitToViewport);
    });
  }
</script>
