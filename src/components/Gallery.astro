---
import { withBase } from '../lib/paths';

interface Props {
  images?: string[];
  title: string;
}

const { images = [], title } = Astro.props;
---

{images.length > 0 && (
  <section class="gallery" aria-label={`Galeria de ${title}`}>
    {images.map((image, index) => (
      <img
        src={withBase(image)}
        alt={`${title}, imagen ${index + 1}`}
        loading="lazy"
      />
    ))}
  </section>
)}
