---
import { withBase } from '../lib/paths';

const links = [
  { href: '/trabajos', label: 'trabajo' },
  { href: '/informacion', label: 'información' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathWithoutBase = Astro.url.pathname.replace(base, '') || '/';
const currentPath = pathWithoutBase === '/' ? '/' : `/${pathWithoutBase.replace(/^\/+|\/+$/g, '')}`;
---

<nav class="menu" aria-label="Navegacion principal">
  <ul>
    {links.map((link) => {
      const isCurrent = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <li>
          <a href={withBase(link.href)} aria-current={isCurrent ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
