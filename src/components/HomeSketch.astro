<section class="home-sketch" aria-label="Animacion de inicio">
  <div id="p5-home-sketch" class="home-sketch__canvas"></div>
  <noscript>
    <p>Animacion disponible con JavaScript activado.</p>
  </noscript>
</section>

<script>
  import p5 from 'p5';
  import type P5 from 'p5';

  const container = document.getElementById('p5-home-sketch');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const smallScreen = window.matchMedia('(max-width: 640px)').matches;

  if (container && !reducedMotion) {
    const sketch = (p: P5) => {
      let points = smallScreen ? 16 : 32;

      const resize = () => {
        const rect = container.getBoundingClientRect();
        p.resizeCanvas(Math.max(280, rect.width), Math.max(260, rect.height));
      };

      p.setup = () => {
        const rect = container.getBoundingClientRect();
        p.createCanvas(Math.max(280, rect.width), Math.max(260, rect.height));
        p.frameRate(smallScreen ? 20 : 30);
      };

      p.draw = () => {
        p.clear();
        p.noFill();
        p.stroke(20, 20, 20, 120);
        p.strokeWeight(1);

        const cx = p.width / 2;
        const cy = p.height / 2;
        const radius = Math.min(p.width, p.height) * 0.28;

        p.beginShape();
        for (let i = 0; i <= points; i += 1) {
          const angle = p.map(i, 0, points, 0, p.TWO_PI);
          const wave = p.sin(angle * 3 + p.frameCount * 0.025) * 18;
          const x = cx + p.cos(angle) * (radius + wave);
          const y = cy + p.sin(angle) * (radius + wave);
          p.vertex(x, y);
        }
        p.endShape();
      };

      p.windowResized = resize;
    };

    const instance = new p5(sketch, container);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        instance.noLoop();
      } else {
        instance.loop();
      }
    });
  }
</script>
