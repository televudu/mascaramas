---
import { withBase } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  theme?: 'light' | 'dark';
  bodyClass?: string;
}

const {
  title = 'mascaramas',
  description = 'Portafolio de animacion y proyectos visuales.',
  theme = 'light',
  bodyClass,
} = Astro.props;

const pageTitle = title === 'mascaramas' ? title : `${title} | mascaramas`;
---

<!doctype html>
<html lang="es" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body class={bodyClass}>
    <main id="contenido">
      <slot />
    </main>
  </body>
</html>
